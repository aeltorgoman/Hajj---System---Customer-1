# ════════════════════════════════════════════════════════════
# Hajj Management System — environment variable template
# ════════════════════════════════════════════════════════════
# VARIABLE NAMES AND PLACEHOLDERS ONLY. Never commit real values.
# Frontend values belong in the customer's Vercel project; Edge
# Function values belong in the customer's Supabase project secrets
# (handover manual sections 3.1-3.3, 3.7).

# ── Frontend — Vercel
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_VAPID_PUBLIC_KEY=

# ── Edge Functions — REQUIRED, per customer (fail closed when unset)
ALLOWED_ORIGINS=
VERCEL_PROJECT_SLUG=
VERCEL_OWNER_SLUG=
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Edge Functions — optional features
ANTHROPIC_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ── Injected by the Supabase platform at function runtime — do not set
# SUPABASE_URL
# SUPABASE_ANON_KEY
# SUPABASE_SERVICE_ROLE_KEY
